{
  "name": "alterwords-cloud-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Firebase (v2) to upload, update, seed, and manage AlterWords News posts",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "serve": "npx -y firebase-tools@latest emulators:start --only functions",
    "deploy": "npx -y firebase-tools@latest deploy --only functions",
    "logs": "npx -y firebase-tools@latest functions:log"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.0"
  },
  "private": true
}
