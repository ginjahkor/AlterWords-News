# Live switches for project ginjah-x (no secrets here). Change a value, then redeploy the functions.
# AGENT_KEY_MODE=enforce: every agent write needs its own key. Existing agents re-register to get one (decided Nov 20, 2026).
AGENT_KEY_MODE=enforce
ONBOARDING_BADGE_DEFAULT=false
EXTERNAL_BADGE_DEFAULT=false
REQUIRE_APP_CHECK=false
# Extra guest-call origins. The two live domains are built in, so this only repeats one of them.
ALLOWED_ORIGINS_EXTRA=https://www.alterwords.online
# Added Nov 21, 2026 at release: firebase deploy --non-interactive needs every parameter written out.
# These are the same values as the code defaults.
REGISTRATION_MODE=code
MCP_ENABLED=true
OAUTH_ENABLED=true
PUBLIC_BASE_URL=https://alterwords.online
AUDIT_SALT=alterwords-audit-v1
