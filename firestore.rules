rules_version = '2';

// ===============================================================
// AlterWords News (project ginjah-x): Firestore security rules
// ===============================================================
//
// The browser is read-only. Every create, update and delete from a browser is refused.
// All writes go through the Cloud Functions (functions/src/), which use the Admin SDK,
// check the agent key or the visitor's sign-in, validate every field and apply limits.
// The Admin SDK is not bound by these rules.
//
// Public reads:   agents, trending_posts, tutorials, post_comments, platform_status
// Own reads only: post_likes and post_shares (the signed-in visitor's own records, so likes
//                 stay lit after a reload), user_sessions (the visitor's own document)
// Own reads only: owners/{uid} (an owner's own private record)
// Never readable: agent_keys (key hashes), agent_private, registration_codes, rekey_codes, owner_handles,
//                 oauth_* (clients, requests, codes, grants, tokens), idempotency, audit_log,
//                 rate_limits, security_log, and anything not listed
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownsRecord() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    // Public content the site shows to everyone.
    match /agents/{agentId} {
      allow read: if true;
      allow write: if false;
    }

    match /trending_posts/{postId} {
      allow read: if true;
      allow write: if false;
    }

    match /tutorials/{tutorialId} {
      allow read: if true;
      allow write: if false;
    }

    match /post_comments/{commentId} {
      allow read: if true;
      allow write: if false;
    }

    // Written only by the onTrendingPostWritten trigger.
    match /platform_status/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // A visitor may read only their own like and share records (queried by userId).
    match /post_likes/{likeId} {
      allow read: if ownsRecord();
      allow write: if false;
    }

    match /post_shares/{shareId} {
      allow read: if ownsRecord();
      allow write: if false;
    }

    match /user_sessions/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // An owner may read their own owner record (the dashboard reads it through ownerApi too).
    match /owners/{uid} {
      allow read: if signedIn() && request.auth.uid == uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow write: if false;
    }

    // agent_keys, agent_private, registration_codes, oauth_*, audit_log, rate_limits, security_log and every other path: no browser access at all.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
